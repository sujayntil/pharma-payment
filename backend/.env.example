# Copy this file to .env and fill in real values before running.

# Postgres connection. When running via docker-compose, this is the "db" service.
# It's addressed by its static IP (set in docker-compose.yml) rather than the
# hostname "db" -- on some machines (VPNs, frequent wifi switching, some
# corporate endpoint security software) Docker's internal DNS stops resolving
# service names, and a fixed IP sidesteps that entirely. If that's not an
# issue on your machine, "postgresql://pharma:pharma@db:5432/pharma_db" works
# too.
DATABASE_URL=postgresql://pharma:pharma@172.31.50.10:5432/pharma_db

# Used to sign login tokens. Set this to a long random string in production.
SECRET_KEY=change-this-to-a-random-secret

# Optional: enables real AI invoice extraction using Google's Gemini vision
# model. Leave blank to run in "manual entry" mode (extraction endpoint
# returns empty fields and the MR fills the review screen in by hand).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_DIR=uploads
